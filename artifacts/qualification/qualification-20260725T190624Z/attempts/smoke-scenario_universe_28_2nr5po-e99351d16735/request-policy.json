{
  "allow_fallbacks": false,
  "data_classification": "SYNTHETIC_PUBLIC_BENCHMARK",
  "endpoint": "https://openrouter.ai/api/v1/chat/completions",
  "max_orchestrator_iterations": 12,
  "max_worker_output_tokens": 2000,
  "max_worker_steps": 8,
  "model": "openai/gpt-oss-20b:free",
  "provider": "Darkbloom",
  "provider_data_collection": "allow",
  "provider_route": "darkbloom",
  "reasoning": {
    "effort": "low"
  },
  "require_parameters": true,
  "sampling": {
    "max_tokens": 4096,
    "temperature": 0.2,
    "top_p": 0.9
  }
}
